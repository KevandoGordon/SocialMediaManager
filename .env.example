# Copy to .env.local and fill in the networks you want to connect. Restart `npm run dev` after editing.
# Each app must list this redirect URL: <APP_URL>/api/connect/<network>/callback
# See docs/connecting-networks.md for step-by-step setup.

# Public address of the app. Defaults to the address you open it at. Set it when using an HTTPS tunnel.
# APP_URL=https://your-tunnel.example

# Optional: 32 random bytes, base64. Without it a key is generated into .data/secret.key.
# TOKEN_ENCRYPTION_KEY=

# Facebook Pages (Meta app with Facebook Login). FACEBOOK_CONFIG_ID only for Facebook Login for Business apps.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_CONFIG_ID=
# META_GRAPH_VERSION=v25.0

# Instagram (Meta app, "Instagram API with Instagram login" product: its own app id and secret)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Threads (Meta app with the Threads use case: its own app id and secret)
THREADS_APP_ID=
THREADS_APP_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube (Google Cloud OAuth client with the YouTube Data API v3 enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
